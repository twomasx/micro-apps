{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-breathwork",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",
  // Production. PAYMENTS_ENABLED, the kill switch, is a secret so it can be flipped without a code change.
  "vars": {
    "PAYMENTS_MODE": "test",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micro-breathwork",
      "database_id": "7e64da56-4b4a-4aa2-92d4-1a3e960d1949",
      // Local dev and tests use their own SQLite file under this id, never the real database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Staging: the `staging` branch, deployed as this project's preview (staging.micro-breathwork.pages.dev),
  // served at https://staging.polymadlabs.com/breathwork/. Stripe test mode, its own database. See PAYMENTS.md.
  "env": {
    "preview": {
      "vars": {
        "PAYMENTS_MODE": "test",
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "micro-breathwork-staging",
          "database_id": "855b7cc9-14bc-42d6-878a-7108d1550297"
        }
      ]
    }
  }
}
