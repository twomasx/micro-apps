# Copy to .env for local dev. Never commit .env. Test mode keys only.
# wrangler pages dev reads this file. Vite only exposes variables prefixed VITE_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
D1_DATABASE_ID=
# Where the site is served. Stripe Checkout sends buyers back here. Local dev runs behind the router (pnpm dev:apps).
PUBLIC_ORIGIN=http://localhost:3000
# The kill switch. Exactly "true" opens checkout. In production it is a Pages secret.
PAYMENTS_ENABLED=true
# Local dev is neither staging nor production.
ENVIRONMENT=local
# wrangler.jsonc says "live" for production. Local dev always uses Stripe test mode and test keys.
PAYMENTS_MODE=test
# The pass service, through the local router. wrangler.jsonc would point at the real site.
PASS_API_ORIGIN=http://localhost:3000
# Same value as the pass service's PASS_SERVICE_KEY.
PASS_SERVICE_KEY=
