# Copy to .env for local dev. Never commit .env. Test mode keys only.
# wrangler pages dev reads this file. Vite only exposes variables prefixed VITE_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
D1_DATABASE_ID=
# Where the site is served. Stripe Checkout sends buyers back here. Local dev: http://localhost:3001
PUBLIC_ORIGIN=
# The kill switch. Exactly "true" opens checkout. In production it is a Pages secret.
PAYMENTS_ENABLED=true
# Local dev is neither staging nor production.
ENVIRONMENT=local
# The pass service. Empty locally unless you run apps/pass too (then http://localhost:3007 through the router).
PASS_API_ORIGIN=
# Same value as the pass service's PASS_SERVICE_KEY.
PASS_SERVICE_KEY=
