{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-personality",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",
  // Production. PAYMENTS_ENABLED, the kill switch, is a secret so it can be flipped without a code change.
  "vars": {
    "PAYMENTS_MODE": "test",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micro-personality",
      // The production database. This id is not a secret.
      "database_id": "9f68da51-44f0-40b7-8ef7-1fc71f12454c",
      // Local dev keeps its own SQLite file under .wrangler/, stored under this id.
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Staging: the `staging` branch, deployed as this project's preview (staging.micro-personality.pages.dev),
  // served at https://staging.polymadlabs.com/personality/. Stripe test mode, its own database. See PAYMENTS.md.
  "env": {
    "preview": {
      "vars": {
        "PAYMENTS_MODE": "test",
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "micro-personality-staging",
          "database_id": "8cd40295-1c1e-4309-8651-3d47e4971a63"
        }
      ]
    }
  }
}
