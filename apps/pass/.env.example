# Copy to .env for local dev. Never commit .env. Test mode keys only.
# wrangler pages dev reads this file. Vite only exposes variables prefixed VITE_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# At least 32 random characters: openssl rand -hex 32
# Pass codes are made from it. Never change it once real codes exist, or they stop working.
PASS_CODE_SECRET=
# Shared with the app servers that check passes themselves (personality, intention): openssl rand -hex 32
PASS_SERVICE_KEY=
# Where the site is served. Stripe Checkout sends buyers back here. Local dev: http://localhost:3007
PUBLIC_ORIGIN=
# The kill switch. Exactly "true" opens checkout. In production it is a Pages secret.
PAYMENTS_ENABLED=true
# Local dev is neither staging nor production.
ENVIRONMENT=local
# Origins allowed to call the pass API from a browser, comma-separated.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3000
