{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-intention",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",
  // request.signal aborts when the browser disconnects, so a run stopped early is saved as abandoned.
  "compatibility_flags": ["enable_request_signal"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micro-intention",
      // Placeholder. Replace with the real id (see D1_DATABASE_ID in .env.example).
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
