{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-intention",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",
  // Production. PAYMENTS_ENABLED, the kill switch, is a secret so it can be flipped without a code change.
  "vars": {
    "PAYMENTS_MODE": "test",
    "ENVIRONMENT": "production",
    "PASS_API_ORIGIN": "https://polymadlabs.com"
  },
  // request.signal aborts when the browser disconnects, so a run stopped early is saved as abandoned.
  "compatibility_flags": ["enable_request_signal"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micro-intention",
      "database_id": "8191fe94-bc95-4272-909b-13dedc75002e"
    }
  ],
  // Staging: the `staging` branch, deployed as this project's preview (staging.micro-intention.pages.dev),
  // served at https://staging.polymadlabs.com/intention/. Stripe test mode, its own database. See PAYMENTS.md.
  "env": {
    "preview": {
      "vars": {
        "PAYMENTS_MODE": "test",
        "ENVIRONMENT": "staging",
        "PASS_API_ORIGIN": "https://staging.polymadlabs.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "micro-intention-staging",
          "database_id": "a6e6f7da-aa25-4876-b3ca-387123c9b54b"
        }
      ]
    }
  }
}
