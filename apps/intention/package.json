{
  "name": "@micro/intention",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n site,functions \"pnpm dev:site\" \"pnpm dev:functions\"",
    "dev:site": "vite",
    "dev:functions": "mkdir -p dist && wrangler pages dev --ip 127.0.0.1 --port 8805",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.functions.json"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@micro/payments": "workspace:*",
    "@micro/platform": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@micro/config": "workspace:*",
    "@micro/seo": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.149.0"
  }
}
