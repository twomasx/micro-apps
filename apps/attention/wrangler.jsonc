{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-attention",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",
  // Production. PAYMENTS_ENABLED, the kill switch, is a secret so it can be flipped without a code change.
  "vars": {
    "PAYMENTS_MODE": "live",
    "ENVIRONMENT": "production",
    "PASS_API_ORIGIN": "https://polymadlabs.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micro-attention",
      "database_id": "06687a75-5da8-4dce-9535-185589abe577",
      // Local dev and tests use their own SQLite file under this id, never the real database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Staging: the `staging` branch, deployed as this project's preview (staging.micro-attention.pages.dev),
  // served at https://staging.polymadlabs.com/attention/. Stripe test mode, its own database. See PAYMENTS.md.
  "env": {
    "preview": {
      "vars": {
        "PAYMENTS_MODE": "test",
        "ENVIRONMENT": "staging",
        "PASS_API_ORIGIN": "https://staging.polymadlabs.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "micro-attention-staging",
          "database_id": "a5a621e1-e2aa-4409-b653-12887d4d26e7"
        }
      ]
    }
  }
}
