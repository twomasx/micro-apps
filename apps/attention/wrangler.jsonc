{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-attention",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micro-attention",
      // Placeholder until deploy (step 8). Replace with the real id (see D1_DATABASE_ID in .env.example).
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Local dev and tests use their own SQLite file under this id, never the real database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
