{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micro-focus",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",
  // Production. PAYMENTS_ENABLED, the kill switch, is a secret so it can be flipped without a code change.
  "vars": {
    "PAYMENTS_MODE": "test",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micro-focus",
      "database_id": "89f48402-5c96-4982-95c3-807c9b08760f",
      // Local dev and tests use their own SQLite file under this id, never the real database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Staging: the `staging` branch, deployed as this project's preview (staging.micro-focus.pages.dev),
  // served at https://staging.polymadlabs.com/focus/. Stripe test mode, its own database. See PAYMENTS.md.
  "env": {
    "preview": {
      "vars": {
        "PAYMENTS_MODE": "test",
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "micro-focus-staging",
          "database_id": "71ce006d-c055-4838-ad63-7c756c183b9a"
        }
      ]
    }
  }
}
